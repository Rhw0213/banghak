from picarx import Picarx
import time

def main():
    px = Picarx()

    # 조향(steering)은 정면(0도)으로 초기화
    px.set_dir_servo_angle(0)
    time.sleep(0.5)

    speed = 30          # 모터 속도 (0~100). 처음엔 낮게 설정해서 테스트하세요.
    move_time = 2        # 한 방향으로 이동할 시간 (초)
    pause_time = 0.5     # 방향 전환 사이의 정지 시간 (초)
    repeat_count = 5     # 왕복 횟수

    try:
        for i in range(repeat_count):
            print(f"[{i+1}/{repeat_count}] 전진")
            px.forward(speed)
            time.sleep(move_time)

            px.stop()
            time.sleep(pause_time)

            print(f"[{i+1}/{repeat_count}] 후진")
            px.backward(speed)
            time.sleep(move_time)

            px.stop()
            time.sleep(pause_time)

    except KeyboardInterrupt:
        print("사용자가 중단했습니다.")

    finally:
        # 안전을 위해 항상 모터를 정지시키고 종료
        px.stop()
        print("모터 정지, 프로그램 종료")


if __name__ == "__main__":
    main()
